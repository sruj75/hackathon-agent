GOOGLE_API_KEY=
COMPOSIO_API_KEY=

# For cron-jobs.org REST API (dynamic timer creation)
CRONJOB_ORG_API_KEY=
BACKEND_HOST=0.0.0.0
# Public URL used in cron callback links. Must be internet-reachable.
# Example: https://your-agent-name.onrender.com
BACKEND_URL=

# Supabase Postgres connection string
# Example: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_DB_URL=
SUPABASE_PROJECT_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# Required Composio apps for user-level connection status
COMPOSIO_REQUIRED_APPS=googlecalendar,googletasks
