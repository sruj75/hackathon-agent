# For Vertex AI Studio
GOOGLE_API_KEY=your_api_key_here

# Conversation live model (override if your project supports a different bidi model)
CONVERSATION_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# For Composio (Google Calendar/Tasks)
COMPOSIO_API_KEY=your_composio_api_key_here

# For cron-jobs.org REST API (dynamic timer scheduling)
CRONJOB_ORG_API_KEY=your_cronjob_org_api_key_here
# Optional: retries for transient 5xx errors from cron-jobs.org
CRONJOB_API_MAX_RETRIES=3

# Backend URL for cron job callbacks (e.g., https://your-app.onrender.com)
BACKEND_URL=https://your-app.onrender.com

# Firebase Configuration
# For LOCAL development: Use file path
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# For RENDER deployment: Use base64-encoded credentials
# Run: base64 -i agent/firebase-service-account.json | tr -d '\n'
# Then paste the output as the value below (uncomment and replace):
# FIREBASE_CREDENTIALS=<paste-base64-string-here>
