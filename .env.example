# For Vertex AI Studio
GOOGLE_API_KEY=your_api_key_here

# For Composio (Google Calendar/Tasks)
COMPOSIO_API_KEY=your_composio_api_key_here

# Backend Server Configuration
# Host to bind the server to:
#   - 0.0.0.0 for all interfaces (recommended for deployment on Render, Railway, Fly.io, etc.)
#   - 127.0.0.1 for localhost only (local development)
BACKEND_HOST=0.0.0.0

# Port to run the server on:
#   - Local development: 8080 (or any available port)
#   - Render/Railway: Usually set via PORT environment variable (they auto-assign)
#   - Note: Most cloud platforms override this with their own PORT variable
BACKEND_PORT=8080